<?xml version="1.0" encoding="utf-8"?>
<!--
    Interfaz de MainActivity (la actividad principal).
    Estructura:
      1. Encabezado con el nombre de la app y un subtítulo.
      2. Una fila horizontal con DOS contenedores de fragmentos:
         - contenedorMenu (izquierda)  -> aquí se carga MenuFragment
         - contenedorDetalle (derecha) -> aquí se cambia el fragmento según la opción
      3. Un botón flotante (FAB) para ir rápido a "Botones" (pagos).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/convive_primario"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvTituloApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="0.1"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:text="@string/titulo_app"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSubtituloApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/convive_primario_claro"
        android:gravity="center"
        android:padding="6dp"
        android:text="@string/subtitulo_inicial"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="italic" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Fragmento IZQUIERDO: menú de opciones -->
            <FrameLayout
                android:id="@+id/contenedorMenu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- Línea divisoria entre los dos fragmentos -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/convive_borde" />

            <!-- Fragmento DERECHO: detalle de la opción seleccionada -->
            <FrameLayout
                android:id="@+id/contenedorDetalle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2.6" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabPagoRapido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="@string/desc_pago_rapido"
            android:src="@drawable/ic_pago"
            app:backgroundTint="@color/convive_acento"
            app:tint="@color/white" />
    </FrameLayout>
</LinearLayout>

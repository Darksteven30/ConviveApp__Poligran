<?xml version="1.0" encoding="utf-8"?>
<!--
    Interfaz del fragmento PERFIL.
    Todo va dentro de un ScrollView (widget con barra de desplazamiento) porque
    el contenido es más alto que la pantalla.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/svPerfil"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fadeScrollbars="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="88dp">

        <TextView
            android:id="@+id/tvEncabezadoPerfil"
            style="@style/TextoTituloSeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_perfil" />

        <ImageView
            android:id="@+id/ivFotoPerfil"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_circulo"
            android:contentDescription="@string/desc_foto_perfil"
            android:padding="18dp"
            android:src="@drawable/ic_perfil" />

        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/convive_texto"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUnidad"
            style="@style/TextoSecundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Tarjeta naranja con el estado de cuenta -->
        <LinearLayout
            android:id="@+id/layoutEstadoCuenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tarjeta_estado"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/estado_cuenta"
                android:textColor="@color/convive_acento_oscuro"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSaldo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/convive_texto"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEstadoPago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/convive_acento_oscuro"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            style="@style/TextoSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/datos_contacto" />

        <TextView
            android:id="@+id/tvCorreo"
            style="@style/TextoCuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvTelefono"
            style="@style/TextoCuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/TextoSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/historial_pagos" />

        <TextView
            android:id="@+id/tvHistorial"
            style="@style/TextoCuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="4dp" />

        <TextView
            style="@style/TextoSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/preferencias" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swNotificaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notificaciones_push" />

        <Button
            android:id="@+id/btnDescargarComprobante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/descargar_comprobante" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- Interfaz del fragmento IZQUIERDO (MenuFragment): un título y una lista (ListView) de opciones -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/convive_fondo_menu"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvEncabezadoMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="8dp"
        android:text="@string/titulo_menu"
        android:textColor="@color/convive_primario"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/lvMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:choiceMode="singleChoice"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:listSelector="@android:color/transparent"
        android:scrollbars="none" />
</LinearLayout>

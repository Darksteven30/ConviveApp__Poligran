<?xml version="1.0" encoding="utf-8"?>
<!-- Diseño de CADA fila del menú: un ícono arriba y el nombre de la opción abajo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutItemMenu"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_item_menu"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:id="@+id/ivIconoOpcion"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tvNombreOpcion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/convive_texto"
        android:textSize="13sp" />
</LinearLayout>

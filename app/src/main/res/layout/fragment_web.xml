<?xml version="1.0" encoding="utf-8"?>
<!-- Interfaz del fragmento WEB: caja de texto para la URL, botón "Ir", barra de progreso y WebView -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvEncabezadoWeb"
        style="@style/TextoTituloSeccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/titulo_web" />

    <TextView
        style="@style/TextoSecundario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/descripcion_web" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_url"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:text="@string/url_inicial"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnCargarUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/cargar_url" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbCargaWeb"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:visibility="gone" />

    <WebView
        android:id="@+id/wvPortal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />
</LinearLayout>
